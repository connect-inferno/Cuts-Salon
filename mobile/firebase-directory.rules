rules_version = '2';

// Rules for the separate "login directory" Firebase project (see
// mobile/lib/firebase/login_directory.dart) - NOT the same project or the
// same rules file as mobile/firestore.rules, which is per-salon.
//
// This project holds one collection: emailDirectory/{email} -> { salonId }.
// Nothing sensitive lives here - no passwords, no salon data - so public
// read is safe: a sign-in attempt has to look someone up before it has any
// way to authenticate anywhere. What must stay locked down is WRITE: if
// this were publicly writable, anyone could repoint another person's email
// at an attacker-controlled Firebase project, and that person's real
// password would then get sent to the attacker's Auth endpoint the next
// time they tried to log in. So writes are limited to operator accounts
// (the operator dashboard, see below) or the Firebase Console.
//
// `get` (fetch one known doc id) is allowed; `list` (enumerate the
// collection) is not - the app only ever does the former, and allowing the
// latter would let anyone harvest every registered email address.
//
// This project also holds a second collection, salons/{salonId}, which is
// unrelated to sign-in: it's an operator-only registry (salon name, owner
// name, owner email, that salon's Firebase project config) for whoever runs
// this SaaS to have one place to look up "what salons exist and who owns
// them" instead of grepping salon_directory.dart. No SALON app code reads or
// writes it - it's managed from the separate operator-dashboard/ tool, whose
// only users are operator accounts created by hand in this project's
// Firebase Auth (Console > Authentication > Add user - there's no public
// sign-up flow, so `request.auth != null` here means "one of the handful of
// people who run this SaaS," not "anyone"). App code and salon
// owners/employees never authenticate against this project, so this gate
// can't be satisfied by salon-side credentials.
service cloud.firestore {
  match /databases/{database}/documents {
    // Writes: operator accounts only (the operator dashboard's "Add Salon"
    // writes the owner's entry here) - the same request.auth gate as
    // salons/ below, and safe for the same reason ONLY while this project's
    // Firebase Auth has public sign-up disabled (Console > Authentication >
    // Settings > User actions > "Enable create (sign-up)" unchecked). If
    // sign-up were on, anyone could create an account here and repoint
    // someone's email - the exact attack described above. Docs are pinned
    // to the single salonId field; deletes stay Console-only.
    match /emailDirectory/{email} {
      allow get: if true;
      allow list: if false;
      allow create, update: if request.auth != null
        && request.resource.data.keys().hasOnly(['salonId'])
        && request.resource.data.salonId is string;
      allow delete: if false;
    }

    match /salons/{salonId} {
      allow read, write: if request.auth != null;
    }
  }
}
