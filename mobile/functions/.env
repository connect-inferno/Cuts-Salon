# Defaults for every salon's WhatsApp functions (see whatsapp.md). A salon
# overrides any of these in its own .env.<projectId>. Nothing secret here -
# the access token is the WHATSAPP_TOKEN secret.
WHATSAPP_TEMPLATE_BILL=bill_receipt
WHATSAPP_TEMPLATE_BIRTHDAY=birthday_wish
WHATSAPP_TEMPLATE_REMINDER=visit_reminder
WHATSAPP_TEMPLATE_LANGUAGE=en
# Same 21 days as kFollowUpDays in the app's client list.
WHATSAPP_REMINDER_DAYS=21
