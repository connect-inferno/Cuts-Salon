rules_version = '2';

// Design convention this whole ruleset depends on: an employee document's ID
// *is* the Firebase Auth uid (see salon_firestore.dart, which creates
// employee docs via .doc(uid).set(...) rather than .add()). That makes "who
// am I" and "is this my own record" a direct get()/uid-compare instead of a
// query - Firestore rules can't run arbitrary queries, only point reads.
//
// Firestore rules grant or deny a whole document, not individual fields, so
// anything only some readers may see needs a document of its own - that is
// why pay lives in employeePay/{uid} rather than on employees/{uid} (see
// that match below).
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function myProfile() {
      return get(/databases/$(database)/documents/employees/$(request.auth.uid)).data;
    }

    // A deactivated employee's Firebase Auth session otherwise stays fully
    // valid (there's no server session to revoke) - this is the Firestore
    // equivalent of the deactivation-bypass fix already shipped on the REST
    // backend (see auth.middleware.ts), so every staff-facing rule below
    // gates on this instead of bare isSignedIn().
    function isActiveEmployee() {
      return isSignedIn() && myProfile().active == true;
    }

    function isOwner() {
      return isActiveEmployee() && myProfile().role == 'OWNER';
    }

    function isSelf(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // "The owner, or the employee this record is about." For per-person
    // records (salary, commission, attendance, targets, payment requests):
    // staff see only their own, the way the REST backend's services scoped
    // a non-owner to their own employeeId. The app already filters staff
    // queries by their own id (loadAppData's selfId), so this only refuses
    // what an edited client could ask for - a coworker's pay.
    function isOwnerOrSubject(subjectUid) {
      return isOwner() || (isActiveEmployee() && request.auth.uid == subjectUid);
    }

    // One-time first-owner bootstrap for a brand-new salon project, used by
    // the operator dashboard's "Add Salon" (operator-dashboard/src/utils/
    // provisionSalon.js). Without it a new salon can never get its first
    // OWNER: employees/ writes need isOwner(), and nobody is one yet.
    //
    // Allowed only as ONE batch that creates both the caller's own
    // employees/{uid} (role OWNER, active) and settings/main, and only while
    // settings/main does not exist yet - exists() sees the state before the
    // batch, existsAfter()/getAfter() the state after it. settings/main is
    // the sentinel: once it exists the door is shut for good, so this must
    // never be deployed to a salon project that lacks settings/main while
    // it already has staff - any signed-in account could claim ownership.
    // The residual risk is the window between deploying these rules to a
    // brand-new project and running Add Salon (Firebase web config is
    // public, so anyone could sign up and claim it first) - run Add Salon
    // straight after the deploy, and the dashboard reports it if the claim
    // was already taken.
    function isBootstrappingOwner() {
      return isSignedIn()
        && !exists(/databases/$(database)/documents/settings/main)
        && existsAfter(/databases/$(database)/documents/settings/main)
        && !exists(/databases/$(database)/documents/employees/$(request.auth.uid))
        && getAfter(/databases/$(database)/documents/employees/$(request.auth.uid)).data.role == 'OWNER'
        && getAfter(/databases/$(database)/documents/employees/$(request.auth.uid)).data.active == true;
    }

    // Single fixed-id document. Employees need gstRate to compute a bill's
    // total, so read is open to any active employee; only the owner edits it.
    // Deletes are closed almost everywhere below. Nothing in the app deletes
    // anything except an expense (services and products are archived,
    // employees deactivated, clients archived), so an open delete would only
    // ever be used by a stolen or tampered owner session to wipe history.

    match /settings/{docId} {
      allow read: if isActiveEmployee();
      allow update: if isOwner();
      allow create: if isOwner() || (docId == 'main' && isBootstrappingOwner());
      allow delete: if false;
    }

    match /branches/{branchId} {
      allow read: if isActiveEmployee();
      allow create, update: if isOwner();
      allow delete: if false;
    }

    // Roster read is open to any active employee (names are needed
    // everywhere: attendance, bills, payment request attribution), plus
    // your own record even when deactivated, so sign-in can tell you why
    // you are locked out. It used to be any signed-in account: Firebase
    // Auth sign-up has to stay on in salon projects (the owner's Add
    // Employee creates accounts from the client), so a stranger could make
    // an account with the public web config and read every employee's
    // phone and salary. get() inside rules is not itself subject to rules,
    // so myProfile() still works with this gate.
    //
    // Only the owner writes employee records. An owner cannot demote or
    // deactivate THEMSELVES - with one owner per salon that locks the salon
    // out for good, and nothing in the app can undo it.
    match /employees/{uid} {
      allow read: if isSelf(uid) || isActiveEmployee();
      allow create: if isOwner() || (isSelf(uid) && isBootstrappingOwner());
      allow update: if isOwner()
        && (!isSelf(uid)
            || (request.resource.data.role == 'OWNER' && request.resource.data.active == true));
      allow delete: if false;
    }

    // One employee's pay (baseSalary, serviceCommissionPct,
    // productCommissionPct), split off employees/{uid} because rules grant
    // whole documents: the roster has to be readable by all staff, pay only
    // by the owner and the employee it belongs to - the REST backend's
    // canSeePay rule (employee.service.ts). Doc id = uid, like employees/.
    // Staff never list it; they fetch their own doc by id. Pay history is
    // the salary slips, so a pay doc is edited, never deleted.
    match /employeePay/{uid} {
      allow get: if isOwnerOrSubject(uid);
      allow list: if isOwner();
      allow create, update: if isOwner()
        && request.resource.data.keys().hasOnly(['baseSalary', 'serviceCommissionPct', 'productCommissionPct']);
      allow delete: if false;
    }

    // Staff read the client list (dues, their work); only the owner adds or
    // edits clients - the staff app has no client screens, and every client
    // write in the app is on the owner side. No deletes - customer history
    // should never disappear (archive instead).
    match /customers/{customerId} {
      allow read: if isActiveEmployee();
      allow create, update: if isOwner();
      allow delete: if false;
    }

    match /serviceCategories/{categoryId} {
      allow read: if isActiveEmployee();
      allow create, update: if isOwner();
      allow delete: if false;
    }

    match /services/{serviceId} {
      allow read: if isActiveEmployee();
      allow create, update: if isOwner();
      allow delete: if false;
    }

    // Owner-only writes, stock included. Staff used to be allowed to touch
    // stockCount because their bills decremented it; staff no longer bill
    // (CLAUDE.md, "Staff don't bill"), so that carve-out only let a staff
    // member zero out or inflate stock.
    match /inventoryItems/{itemId} {
      allow read: if isActiveEmployee();
      allow create, update: if isOwner();
      allow delete: if false;
    }

    // A bill is immutable once created - no PATCH /bills/:id exists on the
    // REST backend either, only create + read. Only the owner creates one:
    // staff don't bill, and a staff-written bill could invent commission
    // for themselves or send a fake WhatsApp receipt to a client. Staff
    // still read bills for the dues list and their own work.
    match /bills/{billId} {
      allow read: if isActiveEmployee();
      allow create: if isOwner();
      allow update, delete: if false;

      match /items/{itemId} {
        allow read: if isActiveEmployee();
        allow create: if isOwner();
        allow update, delete: if false;
      }

      // Settlements of a partly-paid ("pay later") bill. The bill itself is
      // immutable, so a balance cleared afterwards cannot be recorded by
      // editing finalAmount/amountPaid - it lands here instead, one doc per
      // instalment. Append-only for the same reason bills are: a payment
      // that was taken should never be quietly rewritten or removed, and a
      // mistake is corrected by recording a compensating entry. The amount
      // collected *at billing time* stays denormalized on the bill, so this
      // subcollection is empty for the common fully-paid case.
      //
      // Owner-only create: staff must not take money off a balance
      // themselves - they file a paymentRequest (below) and the owner's
      // approval is what writes the payment here. Before this, staff could
      // skip the request and write the payment directly.
      match /payments/{paymentId} {
        allow read: if isActiveEmployee();
        allow create: if isOwner();
        allow update, delete: if false;
      }
    }

    // Per-day billing totals, maintained by createBill's and recordPayment's
    // transactions so the dashboard doesn't have to re-read five weeks of
    // bills on every load. Both of those are owner-only now, and only the
    // owner's dashboard reads it, so this is owner-only end to end - staff
    // have no reason to see the salon's daily takings.
    //
    // Note this is a derived figure, not a source of truth: the bills it
    // summarises are immutable and still hold the real numbers. Delete
    // stays closed so a day can't be made to vanish.
    match /dailyStats/{day} {
      allow read, create, update: if isOwner();
      allow delete: if false;
    }

    // Collection-group read for the same bill items. A collectionGroup()
    // query is evaluated against this wildcard path, NOT the nested
    // bills/{billId}/items rule above, so without this the batched fetch in
    // SalonFirestore.listBillItemsForBills is denied and silently falls back
    // to one read per bill. Scope is unchanged in practice: `items` exists
    // only under bills, and the same isActiveEmployee() gate applies. Reads
    // only - creates still have to go through the nested rule, inside
    // createBill's transaction.
    match /{path=**}/items/{itemId} {
      allow read: if isActiveEmployee();
      allow write: if false;
    }

    // Same collection-group carve-out for the payments ledger above, for the
    // batched fetch in SalonFirestore.listPaymentsForBills - without it that
    // query is denied and silently degrades to one read per bill. Reads
    // only; creates still go through the nested rule inside recordPayment's
    // transaction.
    match /{path=**}/payments/{paymentId} {
      allow read: if isActiveEmployee();
      allow write: if false;
    }

    // Doc id is "{employeeId}_{yyyy-MM-dd}" (employeeId == uid). An active
    // employee clocks only themselves in/out; the owner can also write any
    // record (manual corrections - matches REST's owner-only
    // /attendance/mark).
    // Attendance decides what people get paid, so the honesty of the app is
    // not enough here - these rules are the only thing an edited client
    // cannot talk its way past. Before this, a crafted request could mark
    // itself PRESENT for any date in the past and set any clock-in time it
    // liked; the Dart code always sent today and a server timestamp, but
    // nothing required it to.
    //
    // TIMEZONE, and why this is a window rather than "date == today":
    // `date` is written as local midnight (DateTime(y, m, d) in
    // salon_firestore.dart) and rules evaluate timestamps in UTC. In IST
    // local midnight is 18:30 UTC the PREVIOUS day, so comparing
    // date.day() to request.time.day() would reject every punch this salon
    // ever made. A window absorbs any offset on earth (max +/-14h) while
    // still making "mark me present for last month" impossible.
    match /attendanceRecords/{recordId} {
      function datedNearNow() {
        return 'date' in request.resource.data
            && request.resource.data.date > request.time - duration.value(48, 'h')
            && request.resource.data.date < request.time + duration.value(24, 'h');
      }

      // Confirmation is the owner's signal that a claimed day really
      // happened, and payroll leans on it - so staff must never write it,
      // on create or update.
      function notSelfConfirming() {
        return !('confirmed' in request.resource.data)
            || request.resource.data.confirmed == false;
      }

      // Owner sees everyone's; staff only their own. `resource == null` is a
      // get() of a day that has no record yet - clockIn checks for one
      // before punching, and an empty answer reveals nothing.
      allow get: if isOwner()
        || (isActiveEmployee() && (resource == null || resource.data.employeeId == request.auth.uid));
      allow list: if isOwnerOrSubject(resource.data.employeeId);

      // clockIn == request.time forces FieldValue.serverTimestamp(): a
      // server timestamp resolves to exactly request.time, and any literal
      // the client invents does not. That is what stops someone claiming a
      // 9am arrival at 11am.
      allow create: if isActiveEmployee()
        && datedNearNow()
        && (
          isOwner()
          || (
            isSelf(request.resource.data.employeeId)
            && request.resource.data.clockIn == request.time
            && notSelfConfirming()
          )
        );

      // Staff may punch in once and punch out once, and touch nothing else.
      // Not their status (that is the owner's call), not the date, and not
      // confirmation.
      //
      // Two shapes because a day may already exist before anyone punches:
      // confirming the roster writes a status-only record for every
      // employee, so the first punch of that day is an update, not a create.
      // The location fields ride along with the punch they belong to, and
      // only with it - so a punch cannot be given a different location
      // afterwards, once somebody notices it was recorded miles away.
      //
      // These rules do NOT check the coordinates. Rules cannot: they have no
      // way to know whether the numbers describe where the device really
      // was, and an edited client can send anything. The location is an
      // audit trail for the owner to look at, not a gate. Enforcing it needs
      // a Cloud Function - see the no-trusted-server note in CLAUDE.md.
      function punchingIn() {
        return request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['clockIn', 'clockInLat', 'clockInLng', 'clockInLocationNote'])
            && (!('clockIn' in resource.data) || resource.data.clockIn == null)
            && request.resource.data.clockIn == request.time;
      }

      function punchingOut() {
        return request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['clockOut', 'clockOutLat', 'clockOutLng', 'clockOutLocationNote'])
            && (!('clockOut' in resource.data) || resource.data.clockOut == null)
            && request.resource.data.clockOut == request.time;
      }

      allow update: if isActiveEmployee()
        && (
          isOwner()
          || (isSelf(resource.data.employeeId) && (punchingIn() || punchingOut()))
        );

      // History is evidence. Nobody deletes it, the same way a bill cannot
      // be deleted once raised.
      allow delete: if false;
    }

    // Only generated/paid by the owner (matches salary.routes.ts). Staff
    // read only their own slips (salary.service.ts scoped them the same
    // way); a slip is a pay record, so it is never deleted.
    match /salaryRecords/{recordId} {
      allow read: if isOwnerOrSubject(resource.data.employeeId);
      allow create, update: if isOwner();
      allow delete: if false;
    }

    // Created alongside a bill item inside createBill's transaction (owner
    // only, like the bill); only the owner flips status when marking paid.
    // Staff read only their own (commission.service.ts).
    match /commissionRecords/{recordId} {
      allow read: if isOwnerOrSubject(resource.data.employeeId);
      allow create, update: if isOwner();
      allow delete: if false;
    }

    // Only the owner sets targets (matches salesTarget.routes.ts), and only
    // the owner bumps progress - that happens inside createBill's
    // transaction, which is owner-only now. Staff used to be allowed to
    // write progressValue/status for that reason, which let them mark their
    // own target as met. Staff read only their own.
    match /salesTargets/{targetId} {
      allow read: if isOwnerOrSubject(resource.data.employeeId);
      allow create, update: if isOwner();
      allow delete: if false;
    }

    // Owner-only end to end (matches expense.routes.ts requiring OWNER for
    // the whole router, not just mutations).
    match /expenses/{expenseId} {
      allow read, write: if isOwner();
    }

    // Discount requests are retired - nothing in the app files or reads them
    // any more (CLAUDE.md, "no discount requests any more"). The owner can
    // still read old ones; nobody can file new ones, so the collection is
    // not a write path a tampered client can use.
    match /discountRequests/{requestId} {
      allow read: if isOwner();
      allow write: if false;
    }

    // Settlement requests. Staff can see that a client owes money (the dues
    // list is derived from bills, which they can already read) but must not
    // record the collection themselves - money coming off a balance is the
    // owner's call, the same shape as a discount. So staff raise a request
    // here and the owner approves it, at which point the owner's client
    // writes the real payment through /bills/{billId}/payments.
    //
    // create is pinned to PENDING and to the requester's own uid so a staff
    // member cannot pre-approve their own request or file one under someone
    // else's name; update stays owner-only, and nothing is ever deleted -
    // a refused request is part of the record.
    //
    // Staff read only the requests they filed (the app already asks for
    // exactly that - see payment_requests_provider.dart); the owner reads
    // all. The amount must be a positive number, so the owner's queue never
    // shows a negative or junk "collection".
    match /paymentRequests/{requestId} {
      allow read: if isOwnerOrSubject(resource.data.requestedBy);
      allow create: if isActiveEmployee()
                    && request.resource.data.status == 'PENDING'
                    && request.resource.data.requestedBy == request.auth.uid
                    && request.resource.data.amount is number
                    && request.resource.data.amount > 0;
      allow update: if isOwner();
      allow delete: if false;
    }

    // Running invoice number (counters/invoices = { last: N }), bumped
    // inside createBill's transaction - owner only, like the bill. No
    // REST-era route - the REST backend used random numbers.
    // It may only start at 1 and only ever go up by exactly one, so a
    // client can't reset it or skip ahead; it can still burn a number by
    // bumping without billing, which only leaves a gap.
    match /counters/{counterId} {
      allow read: if isOwner();
      allow create: if isOwner() && counterId == 'invoices'
                    && request.resource.data.keys().hasOnly(['last'])
                    && request.resource.data.last == 1;
      allow update: if isOwner() && counterId == 'invoices'
                    && request.resource.data.keys().hasOnly(['last'])
                    && request.resource.data.last == resource.data.last + 1;
      allow delete: if false;
    }

    // WhatsApp (functions/index.js, a Cloud Function using the Admin SDK,
    // which bypasses these rules). No REST-era route - this postdates it.
    //
    // whatsappLog is the record of every message the function sent or tried
    // to send. The owner may read it; nobody writes it from the app, since a
    // fake "already sent" entry would silently suppress a real message.
    match /whatsappLog/{logId} {
      allow read: if isOwner();
      allow write: if false;
    }

    // whatsappSetup/status { ready: true } marks a salon whose WhatsApp has
    // actually been set up (Meta number, token, functions deployed). Set by
    // the operator in the Console - the app can't see the Meta token, so this
    // is how it knows whether to show the WhatsApp switch or "contact us".
    // Read by staff too: the bill screen checks it. Never client-writable,
    // or any owner could mark themselves set up.
    match /whatsappSetup/{docId} {
      allow read: if isActiveEmployee();
      allow write: if false;
    }

    // The owner's "send test message" / "run today's messages now" buttons.
    // The app can't call Meta itself (that would ship the salon's access
    // token in the app), so it files a request here and the function does
    // the sending and writes the outcome back. create is pinned to the two
    // known types, to PENDING and to the owner's own uid; only the function
    // ever updates one.
    match /whatsappRequests/{requestId} {
      allow read: if isOwner();
      allow create: if isOwner()
                    && request.resource.data.type in ['test', 'daily']
                    && request.resource.data.status == 'pending'
                    && request.resource.data.requestedBy == request.auth.uid;
      allow update, delete: if false;
    }
  }
}
