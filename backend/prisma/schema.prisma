datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id              String           @id @default(uuid())
  email           String           @unique
  passwordHash    String
  role            Role             @default(EMPLOYEE)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  employeeProfile EmployeeProfile?
}

enum Role {
  OWNER
  EMPLOYEE
}

model EmployeeProfile {
  id                   String             @id @default(uuid())
  userId               String             @unique
  user                 User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  name                 String
  phone                String             @unique
  roleTitle            String
  active               Boolean            @default(true)
  baseSalary           Decimal            @db.Decimal(10, 2)
  serviceCommissionPct Decimal            @db.Decimal(5, 2)
  productCommissionPct Decimal            @db.Decimal(5, 2)
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  attendanceRecords    AttendanceRecord[]
  salaryRecords        SalaryRecord[]
  commissions          CommissionRecord[]
  salesTargets         SalesTarget[]
  billItems            BillItem[]
  stockTransactions    StockTransaction[]
}

model Customer {
  id        String    @id @default(uuid())
  name      String
  phone     String    @unique
  email     String?
  gender    String?
  dob       DateTime?
  notes     String?
  isVip     Boolean   @default(false)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  bills     Bill[]

  @@index([phone])
}

model ServiceCategory {
  id        String    @id @default(uuid())
  name      String    @unique
  services  Service[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Service {
  id         String          @id @default(uuid())
  name       String          @unique
  price      Decimal         @db.Decimal(10, 2)
  categoryId String
  category   ServiceCategory @relation(fields: [categoryId], references: [id])
  billItems  BillItem[]
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt
}

model InventoryItem {
  id                String             @id @default(uuid())
  sku               String             @unique
  name              String
  category          String
  price             Decimal            @db.Decimal(10, 2)
  costPrice         Decimal            @db.Decimal(10, 2)
  stockCount        Int                @default(0)
  minAlertThreshold Int                @default(5)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  billItems         BillItem[]
  transactions      StockTransaction[]
}

model StockTransaction {
  id              String           @id @default(uuid())
  inventoryItemId String
  inventoryItem   InventoryItem    @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)
  type            StockTxType
  quantity        Int
  reason          String
  notes           String?
  employeeId      String?
  employee        EmployeeProfile? @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  createdAt       DateTime         @default(now())

  @@index([inventoryItemId])
}

enum StockTxType {
  STOCK_IN
  CONSUMPTION
  RECONCILIATION
  WASTE
  SALE
}

model Bill {
  id               String            @id @default(uuid())
  invoiceNumber    String            @unique
  customerId       String
  customer         Customer          @relation(fields: [customerId], references: [id])
  subTotal         Decimal           @db.Decimal(10, 2)
  discountAmount   Decimal           @default(0) @db.Decimal(10, 2)
  taxAmount        Decimal           @db.Decimal(10, 2)
  finalAmount      Decimal           @db.Decimal(10, 2)
  paymentMethod    PaymentMethod
  status           BillStatus        @default(COMPLETED)
  createdBy        String
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  items            BillItem[]
  discountRequests DiscountRequest[]

  @@index([createdAt])
  @@index([customerId])
}

enum PaymentMethod {
  CASH
  CARD
  UPI
}

enum BillStatus {
  COMPLETED
  REFUNDED
}

model BillItem {
  id                     String           @id @default(uuid())
  billId                 String
  bill                   Bill             @relation(fields: [billId], references: [id], onDelete: Cascade)
  type                   BillItemType
  serviceId              String?
  service                Service?         @relation(fields: [serviceId], references: [id])
  inventoryItemId        String?
  inventoryItem          InventoryItem?   @relation(fields: [inventoryItemId], references: [id])
  quantity               Int              @default(1)
  unitPrice              Decimal          @db.Decimal(10, 2)
  priceOverrideReason    String?
  discountAmount         Decimal          @default(0) @db.Decimal(10, 2)
  employeeId             String
  employee               EmployeeProfile  @relation(fields: [employeeId], references: [id])
  calculatedCommission   Decimal          @db.Decimal(10, 2)
  createdAt              DateTime         @default(now())
  commissionRecords      CommissionRecord[]

  @@index([billId])
  @@index([employeeId])
}

enum BillItemType {
  SERVICE
  PRODUCT
}

model AttendanceRecord {
  id         String          @id @default(uuid())
  employeeId String
  employee   EmployeeProfile @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  date       DateTime        @db.Date
  clockIn    DateTime
  clockOut   DateTime?
  status     AttendanceStatus
  latIn      Float?
  lngIn      Float?
  latOut     Float?
  lngOut     Float?
  notes      String?
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  @@unique([employeeId, date])
  @@index([date])
}

enum AttendanceStatus {
  PRESENT
  LATE
  ABSENT
}

model SalaryRecord {
  id               String          @id @default(uuid())
  employeeId       String
  employee         EmployeeProfile @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  month            Int
  year             Int
  baseSalary       Decimal         @db.Decimal(10, 2)
  commissionEarned Decimal         @db.Decimal(10, 2)
  deductions       Decimal         @default(0) @db.Decimal(10, 2)
  totalPaid        Decimal         @db.Decimal(10, 2)
  status           SalaryStatus    @default(DRAFT)
  paidAt           DateTime?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@unique([employeeId, month, year])
}

enum SalaryStatus {
  DRAFT
  PAID
}

model CommissionRecord {
  id           String           @id @default(uuid())
  employeeId   String
  employee     EmployeeProfile  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  billItemId   String
  billItem     BillItem         @relation(fields: [billItemId], references: [id], onDelete: Cascade)
  amount       Decimal          @db.Decimal(10, 2)
  status       CommissionStatus @default(PENDING)
  calculatedAt DateTime         @default(now())
  paidAt       DateTime?

  @@index([employeeId])
  @@index([status])
}

enum CommissionStatus {
  PENDING
  PAID
}

model SalesTarget {
  id            String          @id @default(uuid())
  employeeId    String
  employee      EmployeeProfile @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  type          TargetType
  targetValue   Decimal         @db.Decimal(10, 2)
  progressValue Decimal         @default(0) @db.Decimal(10, 2)
  startDate     DateTime
  endDate       DateTime
  status        TargetStatus    @default(ACTIVE)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@index([employeeId])
}

enum TargetType {
  SERVICE_VOLUME
  PRODUCT_SALES_COUNT
}

enum TargetStatus {
  ACTIVE
  ACHIEVED
  FAILED
}

model Expense {
  id         String          @id @default(uuid())
  title      String
  amount     Decimal         @db.Decimal(10, 2)
  category   ExpenseCategory
  date       DateTime
  receiptUrl String?
  notes      String?
  createdBy  String
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  @@index([date])
}

enum ExpenseCategory {
  RENT
  UTILITIES
  SUPPLIES
  WAGES
  MISC
}

model DiscountRequest {
  id                String            @id @default(uuid())
  requestedBy       String
  billId            String?
  bill              Bill?             @relation(fields: [billId], references: [id], onDelete: SetNull)
  requestedDiscount Decimal           @db.Decimal(10, 2)
  overridePrice     Decimal?          @db.Decimal(10, 2)
  reason            String
  status            DiscountReqStatus @default(PENDING)
  resolvedBy        String?
  authorizedCode    String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  @@index([status])
}

enum DiscountReqStatus {
  PENDING
  APPROVED
  REJECTED
}

model Settings {
  id                     String   @id @default("global")
  salonName              String   @default("Salon Client")
  phone                  String?
  address                String?
  gstRate                Decimal  @default(18.00) @db.Decimal(5, 2)
  lateAttendancePenalty  Decimal  @default(0.00) @db.Decimal(10, 2)
  updatedAt              DateTime @updatedAt
}
